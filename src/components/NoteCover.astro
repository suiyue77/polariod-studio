---
type Cover = {src: string; permission: 'owned'|'licensed'; credit: string};
interface Props {
  topic: string;
  motif: string;
  category: string;
  title: string;
  url: string;
  cover?: Cover;
}
const {topic,motif,category,title,url,cover} = Astro.props;
const labels:Record<string,string>={light:'LIGHT & EXPOSURE',practice:'CAMERA & PRACTICE',film:'FILM & CARE',creative:'CREATIVE STUDIES'};
---
<a class="note-cover" href={url} rel="noopener noreferrer" data-category={category} data-cover-kind={cover?'source':'studio'} aria-label={`阅读原帖：${title}（${cover?'获准使用的原帖封面':'本站主题封面'}）`}>
  {cover ? (
    <>
      <img src={cover.src} alt="" title={cover.credit} width="640" height="320" loading="lazy" decoding="async" />
      <span class="note-cover-credit">原帖封面 · {cover.credit}</span>
    </>
  ) : (
    <>
      <div class="note-cover-copy" aria-hidden="true">
        <span class="note-cover-kicker">{labels[category]}</span>
        <span class="note-cover-topic">{topic}</span>
        <span class="note-cover-credit">Studio 原创主题封面</span>
      </div>
      <svg class="note-cover-art" viewBox="0 0 168 144" fill="none" aria-hidden="true" focusable="false">
        {motif==='meter' && <g stroke="currentColor" stroke-width="1.5">
          <circle cx="87" cy="70" r="52" opacity=".18"/><circle cx="87" cy="70" r="41" opacity=".65"/><circle cx="87" cy="70" r="24" stroke-dasharray="3 4"/><circle cx="87" cy="70" r="8" fill="currentColor" opacity=".2"/>
          <path d="M87 13v25m0 64v25M30 70h25m64 0h25"/><path d="M87 70L111 45" stroke-width="2.5" stroke-linecap="round"/>
          <path d="M53 36l6 6m56 56 6 6m0-68-6 6m-56 56-6 6" opacity=".55"/>
        </g>}
        {motif==='light' && <g>
          <circle cx="84" cy="65" r="57" fill="currentColor" opacity=".08"/>
          <circle cx="84" cy="65" r="37" fill="currentColor" opacity=".13"/>
          <path d="M84 28a37 37 0 0 1 0 74Z" fill="currentColor" opacity=".72"/>
          <circle cx="84" cy="65" r="37" stroke="currentColor" stroke-width="1.5"/>
          <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M84 3v12m0 100v12M22 65h12m100 0h12M40 21l8 8m72 72 8 8m0-88-8 8m-72 72-8 8"/></g>
        </g>}
        {motif==='lens' && <g stroke="currentColor" stroke-width="1.4">
          <circle cx="84" cy="71" r="56" opacity=".25"/><circle cx="84" cy="71" r="47"/><circle cx="84" cy="71" r="39" opacity=".4"/>
          <g fill="currentColor" fill-opacity=".22"><path d="M84 32l34 20-34 19Z"/><path d="M118 52v39L84 71Z"/><path d="M118 91l-34 19V71Z"/><path d="M84 110L50 91l34-20Z"/><path d="M50 91V52l34 19Z"/><path d="M50 52l34-20v39Z"/></g>
          <path d="M84 52l17 10v19l-17 10-17-10V62Z" fill="var(--cover-bg)"/>
        </g>}
        {motif==='camera' && <g stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
          <path d="M23 49l13-20h97l13 20v69H23Z" fill="currentColor" fill-opacity=".08"/>
          <rect x="23" y="49" width="123" height="62" rx="5"/><path d="M23 101h123M37 41h24m55 0h15"/>
          <circle cx="85" cy="78" r="23" fill="var(--cover-bg)"/><circle cx="85" cy="78" r="16" opacity=".6"/><circle cx="85" cy="78" r="8" fill="currentColor" fill-opacity=".32"/>
          <rect x="34" y="57" width="18" height="12" rx="2"/><rect x="119" y="57" width="14" height="9" rx="2" fill="currentColor" fill-opacity=".25"/>
          <path d="M57 119v14h54v-14" fill="var(--cover-bg)"/><path d="M65 124h38" opacity=".6"/>
        </g>}
        {motif==='film' && <g stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <path d="M37 27h96v101H37Z" fill="currentColor" fill-opacity=".09"/>
          <path d="M27 17h96v101H27Z" fill="var(--cover-bg)"/>
          <path d="M37 27h76v70H37Z" fill="currentColor" fill-opacity=".19"/>
          <path d="M37 97l29-34 18 16 16-21 13 17v22Z" fill="currentColor" fill-opacity=".42" stroke="none"/>
          <path d="M39 107h38" opacity=".5"/>
          <path d="M94 104v8m7-8v8m7-8v8" stroke-width="3"/>
          <path d="M133 28l9 6v94l-9 1" opacity=".65"/>
        </g>}
        {motif==='temperature' && <g stroke="currentColor" stroke-width="1.5">
          <rect x="30" y="27" width="73" height="98" rx="4" fill="currentColor" fill-opacity=".08"/><path d="M39 37h55v69H39Z" fill="currentColor" fill-opacity=".18"/>
          <path d="M48 115h28"/><path d="M117 29v67a14 14 0 1 0 14 0V29a7 7 0 0 0-14 0Z" fill="var(--cover-bg)"/>
          <path d="M124 56v48" stroke-width="4" stroke-linecap="round"/><circle cx="124" cy="108" r="8" fill="currentColor" stroke="none"/>
          <path d="M136 45h9m-9 13h6m-6 13h9"/>
        </g>}
        {motif==='color' && <g>
          <rect x="28" y="20" width="114" height="107" rx="2" fill="#faf7f0" stroke="currentColor" stroke-opacity=".35"/>
          {['#b66b54','#d5a252','#e0ce82','#839d86','#728eaa','#9b8498','#523e3b','#c3c1b5','#e7ddd0'].map((c,i)=><rect x={39+(i%3)*31} y={30+Math.floor(i/3)*26} width="27" height="22" fill={c}/>)}
          <path d="M39 116h40" stroke="currentColor" opacity=".45"/>
        </g>}
        {motif==='check' && <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="39" y="18" width="98" height="112" rx="3" fill="currentColor" fill-opacity=".08"/>
          <path d="M34 28h14m-14 22h14m-14 22h14m-14 22h14m-14 22h14"/>
          {[42,66,90].map(y=><g><rect x="58" y={y} width="12" height="12" rx="2"/><path d={`M60 ${y+6}l3 3 6-8M80 ${y+6}h39`}/></g>)}
          <path d="M80 114h27" opacity=".55"/>
        </g>}
        {motif==='double' && <g>
          <rect x="25" y="28" width="80" height="91" rx="2" transform="rotate(-10 65 73)" fill="#fbf7f0" stroke="currentColor" stroke-opacity=".4"/>
          <rect x="34" y="37" width="62" height="62" transform="rotate(-10 65 73)" fill="currentColor" opacity=".35"/>
          <rect x="64" y="23" width="80" height="91" rx="2" transform="rotate(10 104 69)" fill="#fbf7f0" stroke="currentColor" stroke-opacity=".4"/>
          <rect x="73" y="32" width="62" height="62" transform="rotate(10 104 69)" fill="currentColor" opacity=".22"/>
          <circle cx="75" cy="65" r="29" fill="currentColor" opacity=".29"/><circle cx="107" cy="65" r="29" fill="currentColor" opacity=".32"/>
        </g>}
        {['landscape','flower','portrait','architecture','music','print'].includes(motif) && <g>
          <rect x="28" y="13" width="114" height="119" rx="2" fill="#fbf8ef" stroke="currentColor" stroke-opacity=".35"/>
          <rect x="36" y="21" width="98" height="91" rx="1" fill="currentColor" opacity=".1"/>
          {motif==='landscape' && <g><circle cx="108" cy="43" r="13" fill="currentColor" opacity=".35"/><path d="M36 92l28-42 23 28 19-18 28 32v20H36Z" fill="currentColor" opacity=".45"/><path d="M36 96l34-14 34 12 30-12v30H36Z" fill="currentColor" opacity=".35"/></g>}
          {motif==='flower' && <g stroke="currentColor" stroke-width="1.6"><path d="M84 107V64m0 26q-24-22-31-2 16 9 31 2m0-7q23-22 30-1-16 10-30 1"/><g fill="currentColor" fill-opacity=".3"><ellipse cx="84" cy="45" rx="10" ry="22"/><ellipse cx="84" cy="45" rx="10" ry="22" transform="rotate(60 84 45)"/><ellipse cx="84" cy="45" rx="10" ry="22" transform="rotate(120 84 45)"/></g><circle cx="84" cy="45" r="7" fill="var(--cover-bg)"/></g>}
          {motif==='portrait' && <g fill="currentColor"><circle cx="85" cy="54" r="20" opacity=".5"/><path d="M48 112v-13q37-45 74 0v13Z" opacity=".4"/></g>}
          {motif==='architecture' && <g stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity=".12"><path d="M42 112V63l35-26v75Zm35 0V28l48 26v58Z"/><path d="M53 76h12m-12 14h12m24-31 24 13m-24 0 24 13m-24 0 24 13" fill="none"/></g>}
          {motif==='music' && <g stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M75 82V39l36-7v42M75 49l36-7"/><ellipse cx="66" cy="86" rx="10" ry="7" fill="currentColor"/><ellipse cx="102" cy="78" rx="10" ry="7" fill="currentColor"/></g>}
          {motif==='print' && <g><circle cx="98" cy="48" r="24" fill="currentColor" opacity=".2"/><path d="M36 112V82l32-27 66 46v11Z" fill="currentColor" opacity=".32"/><path d="M36 112l47-44 51 23v21Z" fill="currentColor" opacity=".27"/></g>}
          <path d="M38 121h35" stroke="currentColor" opacity=".4"/>
        </g>}
      </svg>
    </>
  )}
</a>
