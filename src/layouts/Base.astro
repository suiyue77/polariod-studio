---
import '../styles/global.css';
const {title='Polariod Studio',description='一座关于即时摄影的独立小展馆。'}=Astro.props;
const path=Astro.url.pathname;
const links=[{href:'/learn/',label:'教程'},{href:'/creators/',label:'摄影博主'},{href:'/gallery/',label:'照片墙'}];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title==='Polariod Studio'?title:title+' · Polariod Studio'}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head><body><a class="skip" href="#main">跳至正文</a><header class="site-header"><div class="shell header-inner"><a href="/" class="wordmark" aria-label="Polariod Studio 首页">Polariod Studio<span class="spectrum" aria-hidden="true">{['#c34d43','#d59040','#e3bd5c','#769578','#577e9a'].map(c=><i style={`--c:${c}`}/>)}</span></a><nav class="nav" aria-label="主导航">{links.map(l=><a href={l.href} aria-current={path.startsWith(l.href)?'page':undefined}>{l.label}</a>)}</nav></div></header><main id="main" class="shell"><slot/></main><footer class="site-footer"><div class="shell footer-inner"><span>Polariod Studio · 独立即时摄影小志</span><span>非 Polaroid 官方网站 · <a class="text-link" href="/llms.txt">站点索引</a></span></div></footer></body></html>

