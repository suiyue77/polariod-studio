---
type Cover = { src: string; permission: 'owned'|'licensed'; credit: string; width: number; height: number };
interface Props {
  title: string;
  url: string;
  linkLabel?: string;
  cover?: Cover;
}
const {title,url,cover,linkLabel='阅读原帖'} = Astro.props;
---
<a class="note-cover" href={url} rel="noopener noreferrer" data-cover-kind={cover?'source':'unavailable'} aria-label={`${linkLabel}：${title}${cover?'（小红书原帖封面）':''}`}>
  {cover ? (
    <>
      <img src={cover.src} alt={`${title}的原帖封面`} title={cover.credit} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
      <span class="sr-only note-cover-credit">{cover.credit}</span>
    </>
  ) : (
    <span class="note-cover-credit">原帖封面暂未取得</span>
  )}
</a>
