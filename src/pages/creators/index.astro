---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const creators = (await getCollection('creators')).filter(c => c.data.approved);
function platform(url: string) {
  const host = new URL(url).hostname.replace(/^www\./, '');
  const names: Record<string, { label: string; key: string }> = {
    'xiaohongshu.com': { label: '小红书', key: 'xiaohongshu' },
    'xhslink.com': { label: '小红书', key: 'xiaohongshu' },
    'bilibili.com': { label: 'B 站', key: 'bilibili' },
    'space.bilibili.com': { label: 'B 站', key: 'bilibili' },
    'instagram.com': { label: 'Instagram', key: 'instagram' },
    'youtube.com': { label: 'YouTube', key: 'youtube' },
    'youtu.be': { label: 'YouTube', key: 'youtube' },
  };
  return names[host] ?? { label: host, key: 'website' };
}
---
<Base title="摄影博主">
  <section class="page-intro creator-intro">
    <p class="eyebrow">02 / Discover</p>
    <h1>摄影博主</h1>
    <p class="lead">精选即时摄影创作者。通过公开主页发现不同的实拍风格、技法与创作经验。</p>
  </section>
  <section class="page-content creator-page-content">
    {creators.length ? (
      <div class="creator-directory">
        <p class="note creator-count">已收录 {creators.length} 位创作者</p>
        {creators.map(({ data: c }) => {
          const site = platform(c.url);
          const initial = Array.from(c.name.trim())[0] || '·';
          return (
            <article class="creator-card">
              <div class="creator-avatar" aria-hidden="true">
                <span>{initial}</span>
                {c.avatar && <img src={c.avatar.src} alt="" title={c.avatar.credit} width="56" height="56" loading="lazy" decoding="async" />}
              </div>
              <div class="creator-detail">
                <h2>{c.name}</h2>
                <p>{c.description}</p>
                <a class="creator-link" href={c.url} rel="noopener noreferrer" aria-label={`访问 ${c.name} 的${site.label}主页`}>
                  <span class="creator-platform" data-platform={site.key}>{site.label}</span>
                  <span class="creator-link-text">访问主页 <span aria-hidden="true">↗</span></span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="empty"><h2>等待第一批推荐</h2><p>目前没有经过站主确认的摄影博主。名单开放后，每位创作者都会附上推荐理由和原始主页链接，不搬运未经授权的作品。</p></div>
    )}
  </section>
</Base>
